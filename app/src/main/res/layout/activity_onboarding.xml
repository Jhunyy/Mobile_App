<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ======================================= -->
    <!-- DEFAULT ONBOARDING SCREEN -->
    <!-- ======================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_onboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <!-- Position content around middle of screen -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/content_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="283dp" />

        <!-- Kept for compatibility with existing Kotlin -->
        <ImageView
            android:id="@+id/img_shield"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:src="@drawable/ic_safety"
            android:tint="@color/primary" />

        <!-- Title -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_bold"
            android:text="Verify your device"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/content_guideline" />

        <!-- Description -->
        <TextView
            android:id="@+id/text_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/dm_sans_regular"
            android:lineSpacingExtra="4dp"
            android:text="deTEXT needs access to your SMS inbox to detect suspicious messages in real time.&#10;&#10;Your messages remain private – only keywords are analyzed locally on your device."
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_title" />

        <!--
            Retained so existing code that references card_privacy
            will not break. Hidden for the new design.
        -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_privacy"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Privacy Guarantee" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- I'll do this later -->
        <!-- SAME ID retained so existing click function still works -->
        <TextView
            android:id="@+id/text_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/dm_sans_medium"
            android:gravity="center"
            android:padding="10dp"
            android:text="I'll do this later"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Grant SMS Permission -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_permission"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/dm_sans_semibold"
            android:text="Grant SMS Permission"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toTopOf="@id/text_skip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ======================================= -->
    <!-- VERIFICATION COMPLETE OVERLAY -->
    <!-- Hidden until permission is successful -->
    <!-- ======================================= -->

    <FrameLayout
        android:id="@+id/layout_verified"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Verification bottom sheet -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_verified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="44dp"
                android:paddingEnd="28dp"
                android:paddingBottom="28dp">

                <!-- Green check circle -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    app:cardBackgroundColor="@color/primary"
                    app:cardCornerRadius="37dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/dm_sans_bold"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/white"
                        android:textSize="40sp" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Verification title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/dm_sans_bold"
                    android:text="Verification Complete"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />

                <!-- Verification description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/dm_sans_regular"
                    android:text="Your device has been verified."
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />

                <!-- Done button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/dm_sans_semibold"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="28dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>